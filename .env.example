# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Required -------------------------------------------------------------

# Session signing key. Must be >= 32 characters in production.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Public origin. Required in production and must use https://
NEXTAUTH_URL=http://localhost:3000

# MongoDB connection string.
# Local:  mongodb://localhost:27017/cv-builder
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/cv-builder?retryWrites=true&w=majority
# URL-encode any special characters in the password.
MONGODB_URI=mongodb://localhost:27017/cv-builder

# --- Optional -------------------------------------------------------------

# Enables the AI features (ATS review, translate, improve, cover letters).
# Without it those endpoints return 503 and the rest of the app works normally.
OPENAI_API_KEY=

# Model used for every AI call. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Google sign-in. Both values are required together, or neither.
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CVs a new account can create before it needs an upgrade. Defaults to 3.
# FREE_CV_LIMIT=3

# Set to false to disable in-process rate limiting (not recommended in prod).
# RATE_LIMIT_ENABLED=true

# Canonical URL for sitemap/Open Graph. Falls back to NEXTAUTH_URL, then VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://cv.example.com
